##
# ==============================================================================
# default - Template Configuration (neolamia.com / server suite)
# ==============================================================================
# Explanation:
# - This template uses '_' as a generic catch-all server_name instead of a
#   hardcoded domain name.
# - During automated installation, the live site configuration is installed to
#   /etc/nginx/sites-available/neolamia_com.conf and symlinked into
#   /etc/nginx/sites-enabled/neolamia_com.conf.
# - The host's original /etc/nginx/sites-available/default is preserved untouched,
#   while /etc/nginx/sites-enabled/default is unlinked to avoid conflicting server
#   name warnings on port 80/443.
# ==============================================================================
##

server {
	server_name _;
	access_log /tmp/log/nginx/default.log;
	etag on;
	add_header Cache-Control "no-cache";

	root /tmp/html;
	index index.php index.html;

	location / {
		try_files $uri $uri/ =404;
	}

	location ~ \.php$ {
		etag on;
		add_header 'Cache-Control' 'no-cache' always;
		include snippets/fastcgi-php.conf;

		# With php-fpm unix socket:
		fastcgi_pass unix:/run/php/php8.5-fpm.sock;
	}

	# Protect sensitive files and hidden files
	location ~ /\. {
		deny all;
	}

	location ~* \.(sqlite|sql|db|conf|log)$ {
		deny all;
	}
}
