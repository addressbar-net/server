#!/bin/bash
# Helper script to create or extract archives with preserved access times
set -euo pipefail

if [ "$#" -lt 2 ]; then
    echo "Usage: $0 [c|x] <target_or_archive_name>"
    exit 1
fi

ACTION="$1"
TARGET="$2"

if [ "${ACTION}" == "c" ]; then
    tar --atime-preserve -cvpf "${TARGET}.tar" "${TARGET}"
elif [ "${ACTION}" == "x" ]; then
    tar -xvpf "${TARGET}"
else
    echo "Error: Unknown action '${ACTION}'. Use 'c' to create or 'x' to extract." >&2
    exit 1
fi
