#!/bin/bash
# Archives /tmp/html into /var/www/html/server_1.tar
set -euo pipefail

if [ ! -d /tmp/html ]; then
    echo "Error: /tmp/html does not exist." >&2
    exit 1
fi

mkdir -p /var/www/html

cd /tmp
tar -cvpf /var/www/html/server_1.tar html
cp -p /var/www/html/server_1.tar /var/www/html/server_1_HTML.tar 2>/dev/null || true
chmod 644 /var/www/html/server_1.tar /var/www/html/server_1_HTML.tar 2>/dev/null || true

echo "Successfully backed up /tmp/html to /var/www/html/server_1.tar"
