#!/bin/bash
# Archives /tmp/html into /var/www/html/server_1_HTML.tar
set -euo pipefail

if [ ! -d /tmp/html ]; then
    echo "Error: /tmp/html does not exist." >&2
    exit 1
fi

cd /tmp
if command -v Tar >/dev/null 2>&1; then
    Tar c html
else
    tar --atime-preserve -cvpf html.tar html
fi

if [ -f /tmp/html.tar ]; then
    mv /tmp/html.tar /var/www/html/server_1_HTML.tar
    echo "Successfully backed up /tmp/html to /var/www/html/server_1_HTML.tar"
fi
